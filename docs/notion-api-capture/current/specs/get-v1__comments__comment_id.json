                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "id": {
                            "$ref": "#/components/schemas/idResponse",
                            "description": "The ID of the user."
                          },
                          "name": {
                            "description": "The name of the user.",
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "object": {
                            "const": "user",
                            "description": "The user object type name.",
                            "type": "string"
                          },
                          "person": {
                            "additionalProperties": false,
                            "description": "The person info of the user.",
                            "properties": {
                              "email": {
                                "description": "The email of the person.",
                                "type": "string"
                              }
                            },
                            "type": "object"
                          },
                          "type": {
                            "const": "person",
                            "description": "The type of the user.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "object",
                          "name",
                          "avatar_url",
                          "type",
                          "person"
                        ],
                        "type": "object"
                      },
                      {
                        "$ref": "#/components/schemas/partialUserObjectResponse"
                      }
                    ]
                  }
                },
                "required": [
                  "type",
                  "user"
                ],
                "title": "User",
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "workspace",
                    "description": "Always `workspace`",
                    "type": "string"
                  },
                  "workspace": {
                    "const": true,
                    "description": "Details about the owner of the bot, when the `type` of the owner is `workspace`. This means the bot is for an internal integration.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "workspace"
                ],
                "title": "Workspace",
                "type": "object"
              }
            ]
          },
          "workspace_id": {
            "description": "The ID of the bot's workspace.",
            "type": "string"
