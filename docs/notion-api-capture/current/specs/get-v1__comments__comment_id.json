      "commentObjectResponse": {
        "additionalProperties": false,
        "properties": {
          "attachments": {
            "description": "Any file attachments associated with the comment.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "category": {
                  "description": "One of: `audio`, `image`, `pdf`, `productivity`, `video`",
                  "enum": [
