                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "has_more": {
                      "description": "Whether there are more results available.",
                      "type": "boolean"
                    },
                    "next_cursor": {
                      "description": "The cursor to use for the next page of results, or null if there are no more results.",
