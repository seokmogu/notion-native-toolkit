                        {
                          "$ref": "#/components/schemas/idResponse"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "object": {
                      "const": "list",
                      "description": "Always `list`",
                      "type": "string"
                    },
                    "results": {
                      "description": "The list of custom emojis.",
                      "items": {
                        "$ref": "#/components/schemas/customEmojiResponse"
                      },
                      "maxItems": 100,
                      "type": "array"
                    },
                    "type": {
                      "const": "custom_emoji",
                      "description": "Always `custom_emoji`",
                      "type": "string"
                    }
                  },
                  "required": [
                    "object",
                    "type",
