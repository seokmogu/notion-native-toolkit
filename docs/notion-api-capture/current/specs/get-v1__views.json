  "paths": {
    "/v1/views": {
      "get": {
        "operationId": "list-views",
        "parameters": [
          {
            "in": "query",
            "name": "database_id",
            "schema": {
              "$ref": "#/components/schemas/idRequest",
              "description": "ID of a Notion database (collection view block) to list views for. At least one of database_id or data_source_id is required."
            }
          },
          {
            "in": "query",
            "name": "data_source_id",
            "schema": {
              "$ref": "#/components/schemas/idRequest",
              "description": "ID of a data source (collection) to list all views for, including linked views across the workspace. At least one of database_id or data_source_id is required."
            }
          },
          {
            "in": "query",
            "name": "start_cursor",
            "schema": {
              "description": "If supplied, this endpoint will return a page of results starting after the cursor provided. If not supplied, this endpoint will return the first page of results.",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "description": "The number of items from the full list desired in the response. Maximum: 100",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/notionVersion"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "has_more": {
                      "type": "boolean"
                    },
                    "next_cursor": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/idResponse"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "object": {
                      "const": "list",
                      "description": "Always `list`",
                      "type": "string"
                    },
                    "request_status": {
                      "$ref": "#/components/schemas/requestStatusResponse"
                    },
                    "results": {
                      "items": {
                        "$ref": "#/components/schemas/dataSourceViewReferenceResponse"
                      },
                      "type": "array"
                    },
                    "type": {
                      "const": "view",
                      "description": "Always `view`",
                      "type": "string"
                    },
                    "view": {
                      "$ref": "#/components/schemas/emptyObject"
                    }
                  },
                  "required": [
                    "object",
                    "next_cursor",
                    "has_more",
                    "results",
                    "type",
                    "view"
                  ],
                  "type": "object"
                }
              }
            },
            "description": ""
          },
